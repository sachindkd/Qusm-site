# Discord OAuth / live role verification
DISCORD_CLIENT_ID=your-discord-application-client-id
DISCORD_CLIENT_SECRET=your-discord-application-client-secret
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=1426271681969655913
# Must exactly match the Redirect URI registered in the Discord Developer Portal.
DISCORD_REDIRECT_URI=https://your-production-domain.com/api/auth/callback/discord

# Session signing secret (32+ characters)
NEXTAUTH_SECRET=replace-with-random-string

# Optional canonical production URL; used when DISCORD_REDIRECT_URI is omitted.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# Persistent CMS database. Neon/Postgres is recommended on Vercel.
DATABASE_URL=your-neon-postgres-connection-string

# Vercel Blob storage for developer media uploads.
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# Optional Discord announcements channel.
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=your-channel-id
